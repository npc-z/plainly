[Desktop Entry]
Type=Application
Name=Plainly
GenericName=Explain difficult English
Comment=Press a key and the Passage on the clipboard comes back as leveled English, glosses and a translation
Exec=plainly-desktop
Icon=dev.plainly.app
Terminal=false
Categories=Education;Utility;
# The file name and `Icon` carry the identifier `dev.plainly.app`, which also
# names the config and data directories. This line carries the window's Wayland
# app_id, a different name. `tao` builds its `gtk::Application` with no
# application ID, so GTK publishes the program name, `plainly-desktop`. Tauri's
# `enableGTKAppId` could make the app_id the identifier, but it stays off because
# the single-instance it turns on takes the second launch over before `--watch`'s
# handover socket sees it. Without this line the launcher groups the window under
# a second, nameless icon.
StartupWMClass=plainly-desktop
Keywords=English;gloss;translation;clipboard;
