{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainly",
  "version": "0.1.0",
  "identifier": "dev.plainly.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plainly",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
